DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-local-development-secret

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=
DB_NAME=hotel_erp_db
DB_USER=postgres
DB_PASSWORD=replace-with-local-db-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

EMAIL_USER=
EMAIL_PASS=

CHAPA_SECRET_KEY=replace-with-chapa-secret
CHAPA_WEBHOOK_SECRET=replace-with-webhook-secret
CHAPA_BASE_URL=https://api.chapa.co/v1
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://127.0.0.1:8000

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Observability
RELEASE_VERSION=local-development
LOG_LEVEL=INFO

# Database performance safety limits
DB_CONN_MAX_AGE=60
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=60000
