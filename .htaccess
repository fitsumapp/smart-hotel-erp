# ── React Router & Django Admin fix ──────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirect /admin to /api/admin/
  RewriteRule ^admin(/.*)?$ /api/admin$1 [R=301,L]

  # 2. Bypass rewriting for backend API requests (handled by Passenger)
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # 3. Serve Django static assets directly from staticfiles directory
  RewriteRule ^static/(unfold|admin|rest_framework|css)/(.*)$ staticfiles/$1/$2 [L]
  RewriteRule ^staticfiles/ - [L]

  # 4. Serve static files directly if they exist
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # 5. Route all other requests to React index.html for client-side routing
  RewriteRule . /index.html [L]
</IfModule>

# ── Cache Control ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # index.html — NEVER cache
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # CSS, JS, Fonts — cache for performance
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(ico|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>
